  "layout": {
    "viewportChecks": [
      320,
      375,
      390,
      768,
      1024,
      1440,
      1920
    ],
    "containerMax": 1440,
    "wide": {
      "columns": 12,
      "margin": 64,
      "gutter": 24
    },
    "medium": {
      "columns": 8,
      "margin": 32,
      "gutter": 20
    },
    "small": {
      "columns": 4,
      "margin": 20,
      "gutter": 16
    },
    "readingMaxCharacters": 72,
    "fluidPageGutter": "clamp(20px, 4vw, 64px)"
  },
  "motion": {
    "instant": "0ms",
    "micro": "120ms",
    "quick": "160ms",
    "standard": "240ms",
    "enter": "320ms",
    "exit": "200ms",
    "easeStandard": "cubic-bezier(.2,.8,.2,1)",
    "easeEnter": "cubic-bezier(.16,1,.3,1)",
    "easeExit": "cubic-bezier(.4,0,1,1)",
    "reduced": "Remove nonessential transform/scroll animation; retain essential state feedback without motion.",
    "allowedProperties": [
      "opacity",
      "transform",
      "background-color",
      "border-color",
      "box-shadow"
    ],
    "examples": [
      "button hover and press",
      "content transition",
      "entry",
      "indicator slide",
      "panel reveal",
      "confirmation pulse",
      "loading spinner",
      "loading dots",
      "skeleton pulse"
    ],
    "loading": "900ms spinner/dots; 1400ms skeleton; disable repetition under prefers-reduced-motion while preserving status text"
  },
  "elevation": {
    "subtle": "0 2px 8px rgba(20,38,26,.08)",
    "raised": "0 8px 24px rgba(20,38,26,.12)"
  },
  "format": "will-labs/custom-token-map-v1; semantic modes are light/dark pairs",
  "component": {
    "button": {
      "height": {
        "sm": 32,
        "md": 40,
        "lg": 48
      },
      "paddingInline": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "radius": 8,
      "states": [
        "normal",
        "hover",
        "pressed",
        "focus-visible",
        "selected",
        "disabled",
        "loading"
      ],
      "coarsePointerMinHeight": 44,
      "variants": [
        "primary",
        "outline",
        "ghost",
        "danger",
        "warning",
        "success",
        "information",
        "danger-outline",
        "warning-outline",
        "success-outline"
      ],
      "selection": "aria-pressed on toggle button with fixed label",
      "roles": {
        "danger": "irreversible action",
        "warning": "review/caution",
        "success": "positive confirmation",
        "information": "details/help"
      }
    },
    "input": {
      "height": {
        "sm": 32,
        "md": 40,
        "lg": 48
      },
      "paddingInline": 12,
      "radius": 8,
      "states": [
        "empty",
        "filled",
        "hover",
        "focus-visible",
        "invalid",
        "disabled",
        "loading",
        "clearable"
      ]
    },
    "tag": {
      "minHeight": 28,
      "paddingInline": 10,
      "radius": 999,
      "states": [
        "default",
        "selected",
        "disabled"
      ]
    },
    "card": {
      "padding": {
        "sm": 16,
        "md": 24,
        "lg": 32
      },
      "radius": 16,
      "states": [
        "default",
        "hover",
        "focus-visible",
        "selected"
      ]
    },
    "touchTarget": {
      "minimumAA": 24,
      "preferred": 44
    },
    "select": {
      "height": {
        "sm": 32,
        "md": 40,
        "lg": 48
      },
      "radius": 8,
      "variants": [
        "native",
        "avatar",
        "disabled"
      ],
      "states": [
        "empty",
        "selected",
        "focus-visible",
        "disabled"
      ]
    },
    "choice": {
      "controlSize": 18,
      "states": [
        "unchecked",
        "checked",
        "focus-visible",
        "disabled"
      ]
    },
    "switch": {
      "touchTarget": 44,
      "track": {
        "width": 48,
        "height": 28
      },
      "states": [
        "off",
        "on",
        "focus-visible",
        "disabled"
      ]
    },
    "tabs": {
      "minTargetHeight": 44,
      "states": [
        "default",
        "selected",
        "focus-visible",
        "disabled"
      ],
      "keyboard": [
        "ArrowLeft",
        "ArrowRight",
        "Home",
        "End"
      ]
    },
    "disclosure": {
      "minTargetHeight": 44,
      "radius": 8,
      "states": [
        "closed",
        "open",
        "focus-visible"
      ]
    },
    "progress": {
      "states": [
        "running",
        "complete",
        "error"
      ],
      "aria": "value and descriptive text"
    },
    "toast": {
      "role": "status",
      "lifetimeMs": 3500,
      "dismiss": "automatic for informational feedback"
    },
    "search": {
      "inherits": "input",
      "variants": [
        "clearable",
        "loading",
        "empty",
        "results"
      ]
    },
    "password": {
      "inherits": "input",
      "variants": [
        "masked",
        "visible",
        "clearable"
      ]
    },
    "textarea": {
      "minHeight": 80,
      "radius": 8,
      "variants": [
        "empty",
        "filled",
        "invalid",
        "disabled"
      ]
    },
    "date": {
      "inputType": "date",
      "height": {
        "sm": 32,
        "md": 40,
        "lg": 48
      }
    },
    "datetime": {
      "inputType": "datetime-local",
      "height": {
        "sm": 32,
        "md": 40,
        "lg": 48
      }
    },
    "time": {
      "inputType": "time",
      "height": {
        "sm": 32,
        "md": 40,
        "lg": 48
      }
    },
    "number": {
      "inputType": "number",
      "height": {
        "sm": 32,
        "md": 40,
        "lg": 48
      },
      "constraints": [
        "min",
        "max",
        "step"
      ]
    },
    "multiSelect": {
      "variants": [
        "tags",
        "checkbox",
        "avatar",
        "async-simulated"
      ],
      "states": [
        "empty",
        "selected",
        "loading",
        "no-results",
        "error"
      ],
      "behaviors": [
        "remove-one",
        "clear-all",
        "cancel-stale-search"
      ],
      "aria": "native checkbox group, live status and labeled trigger"
    },
    "duration": {
      "inputType": "text",
      "format": "HH:MM:SS",
      "validation": "minutes and seconds 00–59",
      "states": [
        "empty",
        "valid",
        "invalid",
        "disabled"
      ]
    }
  },
  "accessibility": {
    "target": "WCAG 2.2 AA",
    "normalTextContrast": 4.5,
    "largeTextContrast": 3,
    "uiContrast": 3,
    "reflowMinimumViewport": 320,
    "focus": "visible two-layer outline with 3:1 against adjacent colors",
    "textSpacing": "Do not clip at 1.5 line height, 2 paragraph spacing, .12em letter spacing, .16em word spacing",
    "colorMeaning": "Never signal state by color alone",
    "motion": "Honor prefers-reduced-motion"
  },
  "typographyPolicy": {
    "display": "Roboto 600–700 em títulos; escala e espaço definem a hierarquia, sem tracking excessivamente negativo",
    "body": "Roboto 400 em 16–17 px, entrelinha de 1,5 a 1,65 e linha de leitura até ~72 caracteres; 500–600 em controles",
    "utility": "Roboto Mono 400–500 para metadados, números e código; evitar em parágrafos",
    "fallback": "Arial / sans-serif / monospace; preservar entrelinha legível",
    "fontLoading": "font-display swap; preconnect para fontes remotas; hospedagem local em produção após revisão da licença"
  },
  "spaceRoles": {
    "pageGutter": {
      "small": 20,
      "medium": 32,
      "large": 64
    },
    "sectionPaddingBlock": {
      "small": 64,
      "medium": 80,
      "large": 96
    },
    "cardPadding": {
      "compact": 16,
      "default": 24,
      "comfortable": 32
    },
    "stackGap": {
      "labelField": 8,
      "related": 12,
      "group": 24,
      "section": 48
    },
    "inlineGap": {
      "iconLabel": 8,
      "buttonGroup": 12,
      "cardGrid": 16
    },
    "marginPolicy": "Container centralizado por margin-inline:auto; preferir gap para irmãos e padding no container. Margem de parágrafo e título definida no contexto."
  },
  "border": {
    "subtle": "1px solid var(--wl-color-border-default)",
    "strong": "1px solid var(--wl-color-border-strong)",
    "focusWidth": "3px",
    "focusOffset": "2px",
    "radiusRoles": {
      "control": 8,
      "card": 16,
      "panel": 16,
      "pill": 999
    }
  },
  "navigation": {
    "global": [
      "indice",
      "cores",
      "tipografia",
      "ritmo",
      "dimensoes",
      "componentes",
      "movimento",
      "acessibilidade"
    ],
    "components": "individual hash links in expandable sticky index"
  }
}
